[Unit]
Description=Pacemaker-managed OCI LanceDB shared-table ingestion controller
After=network-online.target lancedb-nfs-ingestion-worker.service
Wants=network-online.target

[Service]
Type=simple
User={{ lancedb_service_user }}
Group={{ lancedb_service_group }}
WorkingDirectory={{ lancedb_install_path }}
EnvironmentFile=/etc/lancedb-nfs/lancedb.env
ExecStart={{ lancedb_virtualenv_path }}/bin/oci-lancedb-ingestion-controller
Restart=no
NoNewPrivileges=true
PrivateTmp=true
