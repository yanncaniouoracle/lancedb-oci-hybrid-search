---
# Values generated by the upstream oci-nfs inventory.
nfs_server_vip: "10.0.0.50"
nfs_export_path: "/mnt/nfsshare/exports"
nfs_pacemaker_group: "nfsgroup"
nfs_gpu_client_cidrs:
  - "10.0.0.0/24"

# The shared table is created below the upstream NFS export path.
lancedb_nfs_database_path: "{{ nfs_export_path }}/lancedb-hot"
lancedb_nfs_table_name: "object_events_vectors"
lancedb_nfs_vector_dimensions: 768
lancedb_nfs_mount_path: "/mnt/lancedb-hot"

# Public repository and immutable revision preferred for repeatable installs.
lancedb_service_git_url: "https://github.com/yanncaniouoracle/lancedb-oci-hybrid-search.git"
lancedb_service_git_version: "main"
lancedb_service_user: "ubuntu"
lancedb_service_group: "ubuntu"

# Set true only after the event Function, Queue, and required OCI policies
# exist.  Both storage nodes must be members of the Queue consumer dynamic
# group because the Pacemaker resource may move between them.
lancedb_ingestion_enabled: false
lancedb_ingestion_queue_id: ""
lancedb_ingestion_queue_endpoint: ""
lancedb_source_routes: []
lancedb_oci_bucket: "lancedb-cold"
lancedb_reconciliation_enabled: true
lancedb_reconciliation_interval: "1h"
