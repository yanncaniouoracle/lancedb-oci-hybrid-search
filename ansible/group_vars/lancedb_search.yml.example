# Device paths differ by image and attachment order. Determine them after
# Terraform apply with lsblk -o NAME,SERIAL,SIZE,TYPE and set an explicit list.
lancedb_block_devices:
  - /dev/oracleoci/oraclevdb

lancedb_volume_group: lancedb_hot
lancedb_logical_volume: data
lancedb_mount_path: /mnt/lancedb-hot
lancedb_lvm_stripe_size_kb: 256

lancedb_service_git_url: https://github.com/REPLACE_ORGANIZATION/lancedb-oci-hybrid-search.git
lancedb_service_git_version: main
lancedb_install_path: /opt/oci-lancedb-hybrid
lancedb_service_user: ubuntu
lancedb_service_group: ubuntu

lancedb_database_path: /mnt/lancedb-hot/lancedb-hot
lancedb_table_name: REPLACE_TABLE_NAME
lancedb_vector_dimensions: 768
lancedb_bind_host: 0.0.0.0
lancedb_service_port: 8080
lancedb_grpc_service_port: 50051
# One gRPC server process per node; this is a request-thread pool, not a
# second LanceDB replica. Benchmark before increasing it.
lancedb_grpc_max_workers: 64
# Start conservatively, then tune under representative load.  A worker is a
# separate process with its own LanceDB connection and filesystem cache usage.
lancedb_service_workers: 1

# Use the CIDR of the private subnet containing the LB. Terraform's generated
# inventory supplies this automatically; specify it explicitly for a manual
# inventory. A dedicated LB subnet keeps this rule narrow.
lancedb_host_firewall_source_cidrs:
  - 10.0.0.0/24

# The service returns source_uri values. GPU/application nodes fetch original
# payloads only after top-k selection, using their own instance principal.
lancedb_oci_bucket: lancedb-cold
lancedb_oci_auth: instance_principal

# Deliberately disabled: the data model and source-change procedure are
# workload-specific. Run the project's ingestion command separately after the
# service host is configured and the table schema has been agreed.
lancedb_initial_ingest_command: ""

# Enable only after Terraform creates the Queue and function bridge. The event
# rule is compartment-wide; this registry deliberately accepts only declared
# bucket/prefix sources. Longest matching prefix wins.
lancedb_ingestion_enabled: true
lancedb_ingestion_worker_port: 8090
lancedb_ingestion_worker_source_cidrs:
  - 10.0.0.0/24
lancedb_ingestion_queue_id: "ocid1.queue.oc1..."
lancedb_ingestion_queue_endpoint: "https://cell-1.queue.messaging.us-ashburn-1.oci.oraclecloud.com"
lancedb_source_routes:
  - bucket: lancedb-cold
    prefix: ""
    table: REPLACE_TABLE_NAME
