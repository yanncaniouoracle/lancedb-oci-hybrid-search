# Search-tier settings. Copy to /etc/lancedb-search/lancedb.env; it contains no secret.
LANCEDB_URI=/mnt/lancedb-hot/lancedb-hot
LANCEDB_TABLE=mnist_image_vectors
LANCEDB_VECTOR_DIMENSIONS=784
LANCEDB_BIND_HOST=10.0.0.49
LANCEDB_PORT=8080

# GPU-client settings. Instance principal is preferred over static credentials.
OCI_AUTH=instance_principal
OCI_BUCKET=lancedb-cold
LANCEDB_SEARCH_URL=http://10.0.0.49:8080

# Optional when using an instance principal. If omitted, the OCI SDK resolves it.
# OCI_NAMESPACE=examplenamespace
