region              = "us-ashburn-1"
compartment_ocid    = "ocid1.compartment.oc1..example"
availability_domain = "kIdk:US-ASHBURN-AD-1"
deployment_name     = "lancedb-search"
# Omit when networking resources use the deployment compartment.
network_compartment_ocid = "ocid1.compartment.oc1..network-example"
vcn_id              = "ocid1.vcn.oc1.iad.example"
subnet_ocid         = "ocid1.subnet.oc1.iad.example"
gpu_subnet_id       = "ocid1.subnet.oc1.iad.gpu-example"
ssh_public_key      = "ssh-ed25519 AAAA..."
search_image_ocid   = "ocid1.image.oc1.iad.example"

search_shape         = "VM.Standard.E5.Flex"
search_ocpus         = 8
search_memory_gb     = 64
search_service_count = 1

# One 500 GB Balanced volume is a useful feasibility baseline. Increase the
# count to create an LVM stripe set per search node.
hot_tier_volume_count   = 1
hot_tier_volume_size_gb = 500
hot_tier_vpus_per_gb    = 10

object_storage_bucket_name   = "lancedb-cold"
create_object_storage_bucket = false
object_storage_prefix        = "datasets/"

# Set true only after placing the search instances in an existing, narrowly
# scoped dynamic group.
create_instance_principal_policy = false
dynamic_group_name              = null

enable_private_load_balancer = false
